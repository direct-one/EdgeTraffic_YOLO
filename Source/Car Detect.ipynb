## 경로 설정

from pathlib import Path
import shutil

ZIP_NAMES = [
    'Value_500.zip',
]

def find_zip_files():
    searched = []
    found_paths = []
    seen = set()

    def add_found(path: Path):
        resolved = path.resolve()
        key = str(resolved)
        if key not in seen:
            seen.add(key)
            found_paths.append(resolved)

    for zip_name in ZIP_NAMES:
        if colab:
            candidates = [
                Path('/content/drive/MyDrive/ai/files') / zip_name,
                Path('/content/drive/MyDrive/files') / zip_name,
                Path('/content/drive/MyDrive') / zip_name,
                Path('./files') / zip_name,
                Path('../files') / zip_name,
            ]
            searched.extend(candidates)
            for candidate in candidates:
                if candidate.exists():
                    add_found(candidate)

            drive_root = Path('/content/drive/MyDrive')
            if drive_root.exists():
                matches = list(drive_root.rglob(zip_name))
                searched.extend(matches)
                for match in matches:
                    add_found(match)

        candidates = [
            Path('./files') / zip_name,
            Path('../files') / zip_name,
            Path('./') / zip_name,
        ]
        searched.extend(candidates)
        for candidate in candidates:
            if candidate.exists():
                add_found(candidate)

        local_root = Path('.').resolve()
        matches = list(local_root.rglob(zip_name))
        searched.extend(matches)
        for match in matches:
            add_found(match)

    return found_paths, searched

dataset_zip_paths, searched_paths = find_zip_files()

