## 압축 해제 결과 확인

def show_tree(root: Path, max_depth: int = 2):
    root = root.resolve()
    for path in sorted(root.rglob('*')):
        depth = len(path.relative_to(root).parts)
        if depth > max_depth:
            continue
        indent = '  ' * (depth - 1)
        kind = '[D]' if path.is_dir() else '[F]'
        print(f'{indent}{kind} {path.relative_to(root)}')

show_tree(extract_root, max_depth=3)

## 5-클래스 YOLO 데이터셋 정규화

# 이 데이터셋은 이미지 옆 `.txt` 라벨이 아니라,
# 각 split 폴더의 `_annotations.txt`에 `파일명 x1,y1,x2,y2,class ...` 형식으로 박스가 저장되어 있습니다.
# 여기서는 여러 ZIP에서 풀어낸 데이터셋을 하나로 합쳐
# Ultralytics YOLO 형식의 `images/{split}`, `labels/{split}` 구조로 변환하고
# `truck`, `trailer`, `bus`, `car`, `motorcycle` 5개 클래스를 그대로 유지합니다.

import yaml
from collections import Counter
from PIL import Image

IMAGE_SUFFIXES = {'.jpg', '.jpeg', '.png', '.bmp', '.webp'}
SPLITS = ['train', 'valid', 'test']
TARGET_CLASS_NAMES = ['truck', 'trailer', 'bus', 'car', 'motorcycle']

def find_source_root(root: Path) -> Path:
    children = [p for p in root.iterdir() if p.name != '__MACOSX']
    dirs = [p for p in children if p.is_dir()]
    files = [p for p in children if p.is_file()]
    if len(dirs) == 1 and not any(f.suffix.lower() in {'.yaml', '.yml', '.txt'} for f in files):
        return dirs[0]
    return root

def load_class_names(roots):
    for root in roots:
        class_file = next((root / split / '_classes.txt' for split in SPLITS if (root / split / '_classes.txt').exists()), None)
        if class_file is None:
            continue

        raw_names = [line.strip() for line in class_file.read_text(encoding='utf-8-sig').splitlines() if line.strip()]
        if not raw_names:
            raise RuntimeError(f'empty _classes.txt: {class_file}')
        if all(name.isdigit() for name in raw_names):
            raise RuntimeError(f'_classes.txt contains numeric placeholders instead of class names: {class_file} -> {raw_names}')
        if raw_names != TARGET_CLASS_NAMES:
            raise RuntimeError(
                'class order mismatch. '
                f'expected={TARGET_CLASS_NAMES}, found={raw_names}, file={class_file}'
            )
        return raw_names, class_file

    raise RuntimeError('could not find a valid _classes.txt in extracted datasets')

def parse_annotation_line(line: str):
    tokens = line.strip().split()
    if not tokens:
        return None, []

    filename = tokens[0]
    boxes = []
    for token in tokens[1:]:
        values = token.split(',')
        if len(values) != 5:
            continue
        try:
            x1, y1, x2, y2 = [float(v) for v in values[:4]]
            class_id = int(float(values[4]))
        except ValueError:
            continue
        boxes.append((x1, y1, x2, y2, class_id))
    return filename, boxes

def to_yolo_line(box, width: int, height: int, num_classes: int):
    x1, y1, x2, y2, class_id = box
    if class_id < 0 or class_id >= num_classes:
        return None
    x1 = min(max(x1, 0.0), float(width))
    y1 = min(max(y1, 0.0), float(height))
    x2 = min(max(x2, 0.0), float(width))
    y2 = min(max(y2, 0.0), float(height))
    if x2 <= x1 or y2 <= y1:
        return None

    cx = ((x1 + x2) / 2.0) / width
    cy = ((y1 + y2) / 2.0) / height
    bw = (x2 - x1) / width
    bh = (y2 - y1) / height
    return f'{class_id} {cx:.6f} {cy:.6f} {bw:.6f} {bh:.6f}'

def load_split_annotations(split_dir: Path):
    annotation_file = split_dir / '_annotations.txt'
    boxes_by_name = {}
    if annotation_file.exists():
        for raw in annotation_file.read_text(encoding='utf-8').splitlines():
            filename, boxes = parse_annotation_line(raw)
            if filename is None:
                continue
            boxes_by_name[filename] = boxes
    return boxes_by_name, annotation_file

def print_label_samples(dataset_root: Path, split: str, max_files: int = 3):
    label_dir = dataset_root / 'labels' / split
    sample_paths = sorted(label_dir.glob('*.txt'))[:max_files]
    print(f'[{split}] label samples:')
    for path in sample_paths:
        print(f'  - {path.name}')
        text = path.read_text(encoding='utf-8').strip()
        print(f'    {text if text else "<empty>"}')

source_roots = [find_source_root(root) for root in extracted_roots]
class_names, class_source = load_class_names(source_roots)

print('source_roots:')
for root in source_roots:
    print(f'  - {root}')
print('class_names :', class_names)
print('class_src   :', class_source)

if dataset_root.exists():
    shutil.rmtree(dataset_root)

for split in SPLITS:
    (dataset_root / 'images' / split).mkdir(parents=True, exist_ok=True)
    (dataset_root / 'labels' / split).mkdir(parents=True, exist_ok=True)

summary = {
    split: {
        'images': 0,
        'annotated_images': 0,
        'boxes': 0,
        'empty_labels': 0,
        'class_counts': Counter(),
        'datasets': [],
    }
    for split in SPLITS
}

for dataset_index, source_root in enumerate(source_roots, start=1):
    dataset_tag = f'ds{dataset_index}_{source_root.parent.name}'
    print(f'processing {dataset_tag} -> {source_root}')

    for split in SPLITS:
        split_dir = source_root / split
        if not split_dir.exists():
            continue

        boxes_by_name, annotation_file = load_split_annotations(split_dir)
        image_paths = sorted([p for p in split_dir.iterdir() if p.is_file() and p.suffix.lower() in IMAGE_SUFFIXES])

        dataset_images = 0
        dataset_annotated_images = 0
        dataset_boxes = 0
        dataset_empty_labels = 0
        dataset_class_counts = Counter()

        for image_path in image_paths:
            boxes = boxes_by_name.get(image_path.name, [])
            merged_name = f'{dataset_tag}__{image_path.name}'
            dst_image = dataset_root / 'images' / split / merged_name
            dst_label = dataset_root / 'labels' / split / f'{Path(merged_name).stem}.txt'

            shutil.copy2(image_path, dst_image)

            with Image.open(image_path) as img:
                width, height = img.size

            label_lines = []
            for box in boxes:
                dataset_class_counts[box[4]] += 1
                yolo_line = to_yolo_line(box, width, height, len(class_names))
                if yolo_line is None:
                    continue
                label_lines.append(yolo_line)

            dst_label.write_text('\n'.join(label_lines) + ('\n' if label_lines else ''), encoding='utf-8')

            dataset_images += 1
            if boxes:
                dataset_annotated_images += 1
            if label_lines:
                dataset_boxes += len(label_lines)
            else:
                dataset_empty_labels += 1

        summary[split]['images'] += dataset_images
        summary[split]['annotated_images'] += dataset_annotated_images
        summary[split]['boxes'] += dataset_boxes
        summary[split]['empty_labels'] += dataset_empty_labels
        summary[split]['class_counts'].update(dataset_class_counts)
        summary[split]['datasets'].append({
            'tag': dataset_tag,
            'images': dataset_images,
            'annotated_images': dataset_annotated_images,
            'boxes': dataset_boxes,
            'empty_labels': dataset_empty_labels,
            'class_counts': dict(sorted(dataset_class_counts.items())),
            'annotation_file': str(annotation_file) if annotation_file.exists() else ''
        })

val_split = 'valid' if summary.get('valid', {}).get('images', 0) else 'test'
if summary.get('train', {}).get('images', 0) == 0:
    raise RuntimeError('train split images not found')
if summary.get(val_split, {}).get('images', 0) == 0:
    raise RuntimeError('validation split images not found')

missing_classes = []
for class_id, class_name in enumerate(class_names):
    train_count = summary['train']['class_counts'].get(class_id, 0)
    valid_count = summary[val_split]['class_counts'].get(class_id, 0)
    if train_count == 0:
        missing_classes.append(f'{class_name} (train=0)')
    if valid_count == 0:
        print(f'warning: {class_name} has 0 boxes in {val_split}')

if missing_classes:
    raise RuntimeError(f'missing classes in train split: {missing_classes}')

data_yaml = {
    'path': str(dataset_root),
    'train': 'images/train',
    'val': f'images/{val_split}',
    'test': 'images/test' if summary.get('test', {}).get('images', 0) else '',
    'nc': len(class_names),
    'names': class_names
}

yaml_path = dataset_root / 'data.yaml'
yaml_path.write_text(yaml.safe_dump(data_yaml, sort_keys=False, allow_unicode=True), encoding='utf-8')

print('normalized dataset saved to:', dataset_root)
print('split summary:', summary)
print('\n[class counts by split]')
for split in SPLITS:
    if summary[split]['images'] == 0:
        continue
    split_counts = {class_names[class_id]: summary[split]['class_counts'].get(class_id, 0) for class_id in range(len(class_names))}
    print(f'{split}: {split_counts}')
print('\n[data.yaml]')
print(yaml_path.read_text(encoding='utf-8'))
print()
print_label_samples(dataset_root, 'train')
print_label_samples(dataset_root, val_split)

