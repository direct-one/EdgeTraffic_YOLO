yolo = YOLO('yolo11n.pt')
yolo.train(
    data=DATA,
    epochs=100,
    batch=16,
    imgsz=640,
    device=0,
    workers=4,
    project=str(project_root),
    name=RUN_NAME,
    degrees=5.0,
    flipud=0.0,
    fliplr=0.5,
    mosaic=1.0
)

## ONNX 모델로 변환

